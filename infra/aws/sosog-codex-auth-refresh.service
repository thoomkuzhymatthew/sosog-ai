[Unit]
Description=Validate and refresh SOSOG Codex OAuth authentication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sosog/codex-agents
EnvironmentFile=-/etc/sosog/codex-agents.env
ExecStart=/usr/local/libexec/sosog/refresh_codex_auth.sh

UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=64
LimitNOFILE=1024
MemoryHigh=512M
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sosog-codex-auth-refresh
