+def _is_enabled_env_flag(name: str) -> bool:
+    value = os.environ.get(name, "")
+    return value.lower() in {"1", "true", "yes", "on"}
+
+
+def _apply_bedrock_prompt_cache(model: str, messages: list[dict]) -> list[dict]:
+    """
+    Add a Bedrock/Anthropic cache checkpoint to the stable system prefix.
+
+    This is behaviour-neutral: it does not change prompt text, tool schemas, or
+    generation parameters. It only asks Bedrock to cache the system prefix when
+    TAU2_BEDROCK_PROMPT_CACHE=1 is set for Bedrock models.
+    """
+    if not _is_enabled_env_flag("TAU2_BEDROCK_PROMPT_CACHE"):
+        return messages
+    if not model.startswith("bedrock/"):
+        return messages
+
+    system_indices = [
+        idx for idx, message in enumerate(messages) if message.get("role") == "system"
+    ]
+    if not system_indices:
+        return messages
+
+    cached_messages = [message.copy() for message in messages]
+    last_system_message = cached_messages[system_indices[-1]]
+    last_system_message.setdefault("cache_control", {"type": "ephemeral"})
+    return cached_messages
+
