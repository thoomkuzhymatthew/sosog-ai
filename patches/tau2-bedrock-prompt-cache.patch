+def _estimate_bedrock_sonnet_4_6_cost(response: ModelResponse) -> Optional[float]:
+    usage: Optional[Usage] = response.get("usage")
+    if usage is None:
+        return None
+
+    prompt_tokens = usage.prompt_tokens or 0
+    completion_tokens = usage.completion_tokens or 0
+    cache_creation_tokens = getattr(usage, "cache_creation_input_tokens", 0) or 0
+    cache_read_tokens = getattr(usage, "cache_read_input_tokens", 0) or 0
+    uncached_input_tokens = max(
+        0, prompt_tokens - cache_creation_tokens - cache_read_tokens
+    )
+
+    # Sonnet-class on-demand pricing, per million tokens. Bedrock prompt cache
+    # writes are billed at 1.25x input and reads at a 90% input discount.
+    input_rate = 3.00 / 1_000_000
+    output_rate = 15.00 / 1_000_000
+    cache_write_rate = input_rate * 1.25
+    cache_read_rate = input_rate * 0.10
+    return (
+        uncached_input_tokens * input_rate
+        + cache_creation_tokens * cache_write_rate
+        + cache_read_tokens * cache_read_rate
+        + completion_tokens * output_rate
+    )
+
+
+def get_response_cost(
+    response: ModelResponse, request_model: Optional[str] = None
+) -> float:
     """
     Get the cost of the response from the litellm completion.
     """
+    if request_model and request_model.startswith("bedrock/"):
+        if "claude-sonnet-4-6" in request_model:
+            estimated_cost = _estimate_bedrock_sonnet_4_6_cost(response)
+            if estimated_cost is not None:
+                return estimated_cost
+
     response.model = _parse_ft_model_name(
         response.model
     )  # FIXME: Check Litellm, passing the model to completion_cost doesn't work.
